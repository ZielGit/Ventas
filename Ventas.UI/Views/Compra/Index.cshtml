@model IEnumerable<Ventas.Dominio.Modelos.Compra>

@{
    ViewBag.Title = "Lista de Compras";
}

@section styles{
    <!-- DataTable -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/datatables.net-bs4@1.10.24/css/dataTables.bootstrap4.min.css">
}

<div class="col-12">
    <div class="card">
        <div class="card-body">
            <h2>Lista de Compras</h2>

            <p>
                @Html.ActionLink("Create New", "Create")
            </p>
            <table id="data" class="table table-striped">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.FechaCompra)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Impuesto)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.total)
                        </th>
                        @*<th>
                    @Html.DisplayNameFor(model => model.CompraDetalles)
                </th>*@
                        <th>
                            Acciones
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.FechaCompra)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Impuesto)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.total)
                            </td>
                            @*<td>
                                @Html.DisplayFor(modelItem => item.CompraDetalles)
                            </td>*@
                            <td>
                                @Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
                                @Html.ActionLink("Details", "Details", new { id = item.Id }) |
                                @Html.ActionLink("Delete", "Delete", new { id = item.Id })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section scripts{
    <!-- DataTable -->
    <script src="https://cdn.jsdelivr.net/npm/datatables.net@1.10.24/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/datatables.net-bs4@1.10.24/js/dataTables.bootstrap4.min.js"></script>

    <script>
        $(document).ready(function () {
            $("#data").DataTable();
        })
    </script>
}
